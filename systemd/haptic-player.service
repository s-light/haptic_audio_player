[Unit]
Description=haptic audio player (RFID/buttons -> audio, web UI)
After=sound.target network.target srv-haptic.mount
Wants=srv-haptic.mount

[Service]
Type=simple
User=__USER__
Group=__USER__
SupplementaryGroups=audio i2c gpio spi
WorkingDirectory=__REPO_DIR__
# only reachable through the nginx proxy on port 80 (nginx/haptic-player.conf, setup step `nginx`)
ExecStart=__VENV_DIR__/bin/python -m haptic_player --data-dir __DATA_DIR__ --host 127.0.0.1 --port 8080
# /run/haptic (mpv IPC socket, display frame) - root is read-only, /run is tmpfs
RuntimeDirectory=haptic
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
